# LinkedIn API
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# Indeed API
INDEED_PUBLISHER_ID=your_indeed_publisher_id
INDEED_API_KEY=your_indeed_api_key

# ZipRecruiter API
ZIPRECRUITER_API_KEY=your_ziprecruiter_api_key

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/jobhub

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_USER=your_username
MONGODB_PASSWORD=your_password
MONGODB_DATABASE=jobhub

# Authentication
AUTH0_DOMAIN=your_auth0_domain
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
# OR
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Email Service
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=your_verified_sender_email
# OR
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=your_verified_sender_email

# Email Service Provider Credentials
EMAIL_SERVICE=sendgrid  # Options: sendgrid, mailgun, ses, smtp
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain
SES_ACCESS_KEY=your_aws_access_key
SES_SECRET_KEY=your_aws_secret_key
SES_REGION=us-east-1

# SMTP Configuration (if using SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Storage Configuration
STORAGE_TYPE=s3  # Options: s3, gcs, local
S3_ACCESS_KEY=your_aws_access_key
S3_SECRET_KEY=your_aws_secret_key
S3_BUCKET=your_s3_bucket_name
S3_REGION=us-east-1

# Application Settings
DEFAULT_FROM_EMAIL=applications@yourplatform.com
DEFAULT_FROM_NAME=Your Platform Job Applications
MAX_ATTACHMENT_SIZE=10  # In MB

# Job Search API
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
# OR
INDEED_PUBLISHER_ID=your_indeed_publisher_id

# AI/ML Services
OPENAI_API_KEY=your_openai_api_key
# OR
COHERE_API_KEY=your_cohere_api_key

# Analytics
GA_MEASUREMENT_ID=your_ga_measurement_id
# OR
MIXPANEL_PROJECT_TOKEN=your_mixpanel_token

# Application Configuration
JWT_SECRET=your_jwt_secret
SESSION_SECRET=your_session_secret
CORS_ORIGIN=http://localhost:3000 